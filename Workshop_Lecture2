# Simulated Due Diligence Memo Excerpt (Unstructured Data)
due_diligence_text = """
The target company, "WorkFlow Solutions," operates primarily in the highly competitive Cloud-Based HR Software sector. 
Our preliminary review of their latest financials shows impressive scale. 
Specifically, the last twelve months' (LTM) revenue reached $45 million USD, marking a significant milestone. 
The focus on cost management has kept the LTM EBITDA margin healthy, resulting in an EBITDA of $8.2 million. 
Net Income for the LTM period was $5.1 million. 
Management forecasts a 15% revenue growth rate for the next fiscal year, a critical input for our valuation. 
No major debt issues were identified.
"""

# Step 2: Prompt Engineering for Structured Extraction
# Students define the exact data structure they need, which is a powerful feature of modern GAI APIs (often called JSON Mode or Structured Output).

# Define the structured output format (JSON Schema)
json_schema = {
    "type": "object",
    "properties": {
        "Revenue_LTM": {"type": "integer", "description": "LTM Revenue in USD, numeric only."},
        "EBITDA_LTM": {"type": "integer", "description": "LTM EBITDA in USD, numeric only."},
        "Net_Income_LTM": {"type": "integer", "description": "LTM Net Income in USD, numeric only."},
        "Key_Assumption_Growth": {"type": "string", "description": "Next year's revenue growth rate."},
        "Target_Industry": {"type": "string", "description": "The company's primary industry."}
    },
    "required": ["Revenue_LTM", "EBITDA_LTM", "Net_Income_LTM", "Target_Industry"]
}

# The main prompt for the LLM
extraction_prompt = f"""
ANALYST INSTRUCTION:
You are a senior M&A analyst. Your task is to extract all numerical and critical strategic information from the text provided below.
The output MUST be a valid JSON object that strictly adheres to the following schema: {json_schema}.
Do not include any text outside of the JSON object. Convert all currency values from $X million to full integers (e.g., $45 million becomes 45000000).

TEXT TO ANALYZE:
---
{due_diligence_text}
---
"""

# Call the LLM (using the simulated function)
import json
raw_json_output = call_llm(extraction_prompt, json_schema)
data_dict = json.loads(raw_json_output)

# Step 3: Convert to DataFrame for Analysis
# Convert the extracted dictionary into a Pandas DataFrame for easy downstream analysis
extracted_df = pd.DataFrame([data_dict])
extracted_df['Revenue_LTM_MM'] = extracted_df['Revenue_LTM'] / 1_000_000
extracted_df['EBITDA_LTM_MM'] = extracted_df['EBITDA_LTM'] / 1_000_000

print("\n--- Extracted and Structured Financial Data ---")
print(extracted_df[['Target_Industry', 'Revenue_LTM_MM', 'EBITDA_LTM_MM', 'Key_Assumption_Growth']])
